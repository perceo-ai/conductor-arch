{
  "name": "archductor-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Archductor Electron UI (replaces gtk-app). Talks to the Rust archcar daemon over its Unix socket.",
  "author": "Pranav Kannepalli <pranav.kannepalli@gmail.com>",
  "homepage": "https://github.com/perceo-ai/conductor-arch",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "vite build && electron-builder",
    "dist:dir": "vite build && electron-builder --dir",
    "dist:linux": "vite build && electron-builder --linux"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "solid-js": "^1.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "jsdom": "^30.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^2.1.8"
  }
}
